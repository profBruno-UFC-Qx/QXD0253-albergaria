{
  "kind": "collectionType",
  "collectionName": "imovels",
  "info": {
    "singularName": "imovel",
    "pluralName": "imovels",
    "displayName": "imovel"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo"
    },
    "descricao": {
      "type": "blocks",
      "required": true
    },
    "preco": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "APARTAMENTO",
        "CASA",
        "KITNET",
        "QUARTO",
        "OUTRO"
      ]
    },
    "quartos": {
      "type": "integer",
      "min": 0
    },
    "banheiros": {
      "type": "integer",
      "min": 0
    },
    "metragem": {
      "type": "decimal"
    },
    "midia": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "endereco": {
      "type": "component",
      "component": "localizacao.endereco",
      "repeatable": false
    },
    "status_imovel": {
      "type": "enumeration",
      "default": "ATIVO",
      "enum": [
        "ATIVO",
        "PAUSADO",
        "ALUGADO",
        "INDISPONIVEL"
      ]
    },
    "data_publicacao": {
      "type": "datetime"
    },
    "anunciante": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::anunciante.anunciante",
      "inversedBy": "imovel"
    },
    "favorito": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::favorito.favorito",
      "inversedBy": "imovels"
    }
  }
}
