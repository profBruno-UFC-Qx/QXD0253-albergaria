{
  "kind": "collectionType",
  "collectionName": "imovels",
  "info": {
    "singularName": "imovel",
    "pluralName": "imovels",
    "displayName": "imovel"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "quartos": {
      "type": "integer",
      "min": 0
    },
    "banheiros": {
      "type": "integer",
      "min": 0
    },
    "metragem": {
      "type": "decimal"
    },
    "midia": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "endereco": {
      "type": "component",
      "component": "localizacao.endereco",
      "repeatable": false
    },
    "status_imovel": {
      "type": "enumeration",
      "default": "ATIVO",
      "enum": [
        "ATIVO",
        "PAUSADO",
        "ALUGADO",
        "INDISPONIVEL"
      ]
    },
    "favorito": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::favorito.favorito",
      "inversedBy": "imovels"
    },
    "anunciante": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::anunciante.anunciante",
      "inversedBy": "imovels"
    },
    "categoria": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categoria.categoria",
      "inversedBy": "imovels"
    },
    "anuncios": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::anuncio.anuncio",
      "mappedBy": "imovel"
    }
  }
}
