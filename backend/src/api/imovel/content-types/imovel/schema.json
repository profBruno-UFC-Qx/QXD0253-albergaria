{
  "kind": "collectionType",
  "collectionName": "imovels",
  "info": {
    "singularName": "imovel",
    "pluralName": "imovels",
    "displayName": "imovel"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "quartos": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "banheiros": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "metragem": {
      "type": "decimal",
      "required": true
    },
    "midia": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "endereco": {
      "type": "component",
      "component": "localizacao.endereco",
      "repeatable": false
    },
    "status_imovel": {
      "type": "enumeration",
      "default": "DISPONIVEL",
      "enum": [
        "ATIVO",
        "PAUSADO",
        "ALUGADO",
        "DISPONIVEL",
        "INDISPONIVEL"
      ]
    },
    "tipo_imovel": {
      "type": "enumeration",
      "enum": [
        "APARTAMENTO",
        "CASA",
        "CASA EM CONDOMÍNIO",
        "KITNET / STUDIO",
        "LOFT",
        "COBERTURA",
        "FLAT / APART-HOTEL",
        "QUARTO / REPÚBLICA",
        "SALA COMERCIAL",
        "PONTO COMERCIAL / LOJA",
        "GALPÃO / DEPÓSITO"
      ]
    },
    "favorito": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::favorito.favorito",
      "inversedBy": "imovels"
    },
    "anunciante": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::anunciante.anunciante",
      "inversedBy": "imovels"
    },
    "anuncios": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::anuncio.anuncio",
      "mappedBy": "imovel"
    }
  }
}
